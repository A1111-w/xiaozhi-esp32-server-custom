            auto& app = Application::GetInstance();
            if (app.GetDeviceState() == kDeviceStateStarting) {
                EnterWifiConfigMode();
                return;
            }
            app.ToggleChatState();
        });
    }
public:
    AtomEchoS3rBaseBoard() : boot_button_(USER_BUTTON_GPIO) {
        InitializeI2c();
        I2cDetect();
        InitializeButtons();
    }

    virtual AudioCodec* GetAudioCodec() override {
