  static esp_err_t panel_gc9309na_set_gap(esp_lcd_panel_t *panel, int x_gap, int y_gap)
  {
      gc9309na_panel_t *gc9309 = __containerof(panel, gc9309na_panel_t, base);
      gc9309->x_gap = x_gap;
      gc9309->y_gap = y_gap;
      return ESP_OK;
