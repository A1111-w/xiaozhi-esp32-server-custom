    MoveServos(100, current_pos);

    // servo1.write(150); delay(100);
    current_pos[LEFT_FRONT_LEG] = 30; // servo1
    MoveServos(100, current_pos);
  }

  // servo1.write(90);
  current_pos[LEFT_FRONT_LEG] = 90; // servo1
