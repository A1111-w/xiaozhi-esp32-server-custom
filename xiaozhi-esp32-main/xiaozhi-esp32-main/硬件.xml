        self.loudnorm_frame.grid(row=1, column=0, padx=10, pady=5, sticky="ew")
        
        ttk.Checkbutton(self.loudnorm_frame, text="启用响度调整", 
                       variable=self.enable_loudnorm, width=15
                       ).grid(row=0, column=0, padx=2)
