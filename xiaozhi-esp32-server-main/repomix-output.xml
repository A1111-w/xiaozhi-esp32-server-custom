    async def start_session(self, session_id):
        logger.bind(tag=TAG).debug(f"开始会话～～{session_id}")
        try:       
            # 等待上一个会话结束，最多等待3次
            for _ in range(3):
                if not self.activate_session:
                    break
                logger.bind(tag=TAG).debug(f"等待上一个会话结束...")
                await asyncio.sleep(0.1)
            else:
                # 等待超时，强制清除连接状态
