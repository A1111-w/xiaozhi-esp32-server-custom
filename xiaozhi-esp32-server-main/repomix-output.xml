                                    if "<think>" in content:
                                        continue
                                    if "</think>" in content:
                                        continue
                                    yield content

                    except json.JSONDecodeError as e:
                        continue
                    except Exception as e:
                        continue

    def response_with_functions(self, session_id, dialogue, functions=None):
        logger.bind(tag=TAG).error(
