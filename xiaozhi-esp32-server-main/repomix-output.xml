        @Schema(description = "相似度阈值 (0.0 - 1.0)", example = "0.2")
        @JsonProperty("similarity_threshold")
        private Float similarityThreshold;

        @Schema(description = "关键词相似度权重 (0.0 - 1.0)", example = "0.7")
