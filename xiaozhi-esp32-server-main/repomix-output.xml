    "size": 0,
    "type": "folder",
    "source_type": "",
    "create_time": 1715623500000,
    "create_date": "2024-05-13 10:05:00",
    "update_time": 1715623500000,
    "update_date": "2024-05-13 10:05:00"
  }
}
