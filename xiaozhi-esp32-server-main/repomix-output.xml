2. sed -i ''s/REGISTER_ENABLED=1/REGISTER_ENABLED=0/g'' .env   
3.cat .env | grep -i register
4.看到REGISTER_ENABLED=0 重启服务即可。',  1, NULL, NULL, NULL, NULL);
