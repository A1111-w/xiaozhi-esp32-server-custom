                      {{ t('device.firmwareVersion') }}：{{ device.appVersion }}
                    </text>
                    <text class="block text-[28rpx] text-[#65686f] leading-[1.4]">
                      {{ t('device.lastConnection') }}：{{ formatTime(device.lastConnectedAt) }}
                    </text>
