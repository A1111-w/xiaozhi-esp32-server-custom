    async def open_audio_channels(self, conn):
        try:
            await super().open_audio_channels(conn)
            # 更新 audio_params 中的采样率为实际的 conn.sample_rate
            self.audio_params["sample_rate"] = conn.sample_rate
        except Exception as e:
